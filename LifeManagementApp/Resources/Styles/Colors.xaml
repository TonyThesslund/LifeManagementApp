<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        "Kite" color theme. Every color has a light and a dark version;
        Styles.xaml picks between them with AppThemeBinding.
    -->

    <!-- Sky blue: buttons, links, selected tab, checkboxes -->
    <Color x:Key="PrimaryLight">#0369A1</Color>
    <Color x:Key="PrimaryDark">#38BDF8</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#04202F</Color>
    <!-- Primary color for text on a page or card background -->
    <Color x:Key="PrimaryTextLight">#0369A1</Color>
    <Color x:Key="PrimaryTextDark">#7DD3FC</Color>

    <!-- Sunny yellow: the kitesurf notice -->
    <Color x:Key="AccentLight">#FACC15</Color>
    <Color x:Key="AccentDark">#FDE047</Color>
    <Color x:Key="OnAccent">#2A2000</Color>

    <!-- Backgrounds: warm cream in light mode, softer on the eyes than pure white -->
    <Color x:Key="PageBackgroundLight">#F4EFE6</Color>
    <Color x:Key="PageBackgroundDark">#08121C</Color>
    <Color x:Key="SurfaceLight">#FBF8F2</Color>
    <Color x:Key="SurfaceDark">#0F1C2A</Color>
    <Color x:Key="SurfaceAltLight">#EFE8DB</Color>
    <Color x:Key="SurfaceAltDark">#142536</Color>
    <Color x:Key="BorderLight">#E0D6C4</Color>
    <Color x:Key="BorderDark">#20354A</Color>

    <!-- Title bar and tabs -->
    <Color x:Key="ShellLight">#FBF8F2</Color>
    <Color x:Key="ShellDark">#0B1724</Color>

    <!-- Text -->
    <Color x:Key="TextLight">#0F2233</Color>
    <Color x:Key="TextDark">#E4EEF7</Color>
    <Color x:Key="TextMutedLight">#51677C</Color>
    <Color x:Key="TextMutedDark">#93A9BE</Color>

    <!-- Errors, overdue dates and delete buttons -->
    <Color x:Key="DangerLight">#C62828</Color>
    <Color x:Key="DangerDark">#FF6B6B</Color>

    <!-- Weather card: white text on a blue-to-teal gradient -->
    <Color x:Key="HeroText">#FFFFFF</Color>
    <Color x:Key="HeroMutedLight">#D6EEF8</Color>
    <Color x:Key="HeroMutedDark">#CBE6F2</Color>
    <LinearGradientBrush x:Key="HeroBrushLight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0284C7" Offset="0" />
        <GradientStop Color="#0E7490" Offset="0.55" />
        <GradientStop Color="#155E75" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrushDark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#075985" Offset="0" />
        <GradientStop Color="#0E7490" Offset="0.6" />
        <GradientStop Color="#134E4A" Offset="1" />
    </LinearGradientBrush>

    <!-- Text on a priority color (see PriorityToColorConverter) -->
    <Color x:Key="OnPriority">#1F1F1F</Color>

</ResourceDictionary>
