<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:LifeManagementApp.Converters"
    xmlns:models="clr-namespace:LifeManagementApp.Models">

    <!--
        Styles without x:Key apply to every control of that type.
        Styles with x:Key are used by name: Style="{StaticResource Card}".
    -->

    <!-- Pages and the title bar with tabs -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}" />
        <!-- No big page title above the tabs: the selected tab already says which page this is -->
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource ShellLight}, Dark={StaticResource ShellDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource ShellLight}, Dark={StaticResource ShellDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <!--
        Page content: a centered column with the same padding and spacing on every page,
        so content doesn't stretch across wide windows (760 wide plus 24 padding each side)
    -->
    <Style TargetType="VerticalStackLayout" x:Key="PageColumn">
        <Setter Property="MaximumWidthRequest" Value="808" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="24,24,24,32" />
        <Setter Property="Spacing" Value="20" />
    </Style>

    <!-- Text -->

    <!-- Base for every label; the named label styles below build on it -->
    <Style TargetType="Label" x:Key="BaseLabel">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BaseLabel}" />

    <!-- Heading at the top of a page, e.g. "Edit to-do" -->
    <Style TargetType="Label" x:Key="PageHeading" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
    </Style>

    <!-- Heading of a section on a page, e.g. "Top to-dos" or "Categories" -->
    <Style TargetType="Label" x:Key="SectionHeading" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="19" />
    </Style>

    <!-- Smaller grey text: explanations, dates, categories -->
    <Style TargetType="Label" x:Key="Caption" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Label above a form field, e.g. "Title" or "Due date" -->
    <Style TargetType="Label" x:Key="FieldLabel" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
    </Style>

    <!-- Validation and error messages -->
    <Style TargetType="Label" x:Key="ErrorText" BasedOn="{StaticResource BaseLabel}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
        Due date of a to-do in a list row: "Overdue" in red, "Today" in the theme color, otherwise grey.
        The label binds to the whole to-do: Text="{Binding ., Converter={StaticResource DueDateText}}"
    -->
    <Style TargetType="Label" x:Key="DueLabel" BasedOn="{StaticResource Caption}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Style.Triggers>
            <DataTrigger TargetType="Label" Value="{x:Static converters:DueStatus.Overdue}">
                <DataTrigger.Binding>
                    <Binding Path="." x:DataType="models:TodoItem">
                        <Binding.Converter>
                            <converters:DueStatusConverter />
                        </Binding.Converter>
                    </Binding>
                </DataTrigger.Binding>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Label" Value="{x:Static converters:DueStatus.Today}">
                <DataTrigger.Binding>
                    <Binding Path="." x:DataType="models:TodoItem">
                        <Binding.Converter>
                            <converters:DueStatusConverter />
                        </Binding.Converter>
                    </Binding>
                </DataTrigger.Binding>
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Containers -->

    <!-- One row in a list card (Home's top to-dos, the to-do list) -->
    <Style TargetType="Grid" x:Key="ListRow">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="ColumnSpacing" Value="14" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
    </Style>

    <!--
        The rows of a list card sit 1 apart on a border-colored background,
        so the gaps between them show as divider lines
    -->
    <Style TargetType="VerticalStackLayout" x:Key="ListRows">
        <Setter Property="Spacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <!-- White (dark mode: dark blue) rounded box around a group of content -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- A card that holds one section of a page: heading, explanation and its controls -->
    <Style TargetType="Border" x:Key="SectionCard" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="24,20" />
    </Style>

    <!-- Buttons -->

    <!-- Base for every button: the primary button, filled with the theme color -->
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

    <!-- Secondary button: outlined, for less important actions like Refresh -->
    <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Delete button: red text only -->
    <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Button on the weather card: white outline on the gradient -->
    <Style TargetType="Button" x:Key="HeroButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="TextColor" Value="{StaticResource HeroText}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource HeroMutedLight}, Dark={StaticResource HeroMutedDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Small icon-only button, e.g. the bin that deletes a to-do -->
    <Style TargetType="ImageButton" x:Key="IconButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Inputs -->

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
    </Style>

</ResourceDictionary>
