<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.TodoDetailPage"
             x:DataType="vm:TodoDetailViewModel"
             Title="New to-do">

    <ScrollView>
        <VerticalStackLayout Padding="16"
                             Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Title" />
                <Entry Text="{Binding Title}"
                       Placeholder="What needs to be done?"
                       MaxLength="200" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Notes" />
                <Editor Text="{Binding Notes}"
                        Placeholder="Optional"
                        MaxLength="1000"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="80" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Priority (5 = highest)" />
                <Picker ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding Priority}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Due date" />
                <DatePicker Date="{Binding DueDate}" />
            </VerticalStackLayout>

            <Button Text="Save"
                    Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
