<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.TodoDetailPage"
             x:DataType="vm:TodoDetailViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageColumn}">

            <Label Text="{Binding PageTitle}"
                   Style="{StaticResource PageHeading}" />

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="18">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Title"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Title}"
                               Placeholder="What needs to be done?"
                               FontSize="16"
                               MaxLength="200" />
                        <Label Text="{Binding TitleError}"
                               IsVisible="{Binding HasTitleError}"
                               Style="{StaticResource ErrorText}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notes"
                               Style="{StaticResource FieldLabel}" />
                        <Editor Text="{Binding Notes}"
                                Placeholder="Optional"
                                MaxLength="1000"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="100" />
                    </VerticalStackLayout>

                    <!-- Priority, category and due date side by side; they wrap in a narrow window -->
                    <FlexLayout Wrap="Wrap"
                                JustifyContent="Start">
                        <VerticalStackLayout Spacing="4"
                                             Margin="0,0,24,12"
                                             WidthRequest="160">
                            <Label Text="Priority (5 = highest)"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Priorities}"
                                    SelectedItem="{Binding Priority}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4"
                                             Margin="0,0,24,12"
                                             WidthRequest="200">
                            <Label Text="Category"
                                   Style="{StaticResource FieldLabel}" />
                            <Picker ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=models:Category}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4"
                                             Margin="0,0,0,12"
                                             WidthRequest="180">
                            <Label Text="Due date"
                                   Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding DueDate}" />
                        </VerticalStackLayout>
                    </FlexLayout>

                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="End">
                <Button Text="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Text="Save"
                        MinimumWidthRequest="100"
                        Command="{Binding SaveCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
