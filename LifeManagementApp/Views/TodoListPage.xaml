<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.TodoListPage"
             x:DataType="vm:TodoListViewModel"
             Title="To-dos">

    <ContentPage.Resources>
        <!--
            One to-do row, used in both the "To do" and "Done" sections:
            checkbox, priority dot, "Title · Category · P3", due date and a bin button.
        -->
        <DataTemplate x:Key="TodoRow"
                      x:DataType="models:TodoItem">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                  Style="{StaticResource ListRow}"
                  Padding="8,4,8,4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditTodoCommand, Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, x:DataType=vm:TodoListViewModel}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>

                <Grid VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleDoneCommand, Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, x:DataType=vm:TodoListViewModel}"
                                              CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <!-- InputTransparent: the tap goes to the Grid's command, the CheckBox only shows the state -->
                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                              InputTransparent="True" />
                </Grid>

                <Ellipse Grid.Column="1"
                         WidthRequest="10"
                         HeightRequest="10"
                         VerticalOptions="Center"
                         Fill="{Binding Priority, Converter={StaticResource PriorityToColor}}" />

                <Label Grid.Column="2"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Title}"
                                  FontFamily="OpenSansSemibold"
                                  FontSize="15"
                                  TextDecorations="{Binding IsDone, Converter={StaticResource BoolToStrikethrough}}" />
                            <Span Text="{Binding Category.Name, StringFormat=' · {0}', TargetNullValue='', FallbackValue=''}"
                                  FontSize="13"
                                  TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Span Text="{Binding Priority, StringFormat=' · P{0}'}"
                                  FontSize="13"
                                  TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Grid.Column="3"
                       Text="{Binding ., Converter={StaticResource DueDateText}}"
                       Style="{StaticResource DueLabel}" />

                <ImageButton Grid.Column="4"
                             Source="{AppThemeBinding Light=bin_light.png, Dark=bin_dark.png}"
                             Style="{StaticResource IconButton}"
                             SemanticProperties.Description="Delete"
                             ToolTipProperties.Text="Delete"
                             Command="{Binding DeleteTodoCommand, Source={RelativeSource AncestorType={x:Type vm:TodoListViewModel}}, x:DataType=vm:TodoListViewModel}"
                             CommandParameter="{Binding .}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageColumn}">

            <!-- Filters on the left, Add on the right; wraps onto two lines in a narrow window -->
            <FlexLayout Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Center">
                <HorizontalStackLayout Spacing="8"
                                       Margin="0,0,16,0">
                    <Label Text="Sort by"
                           Style="{StaticResource Caption}"
                           VerticalOptions="Center" />
                    <Picker ItemsSource="{Binding SortOrders}"
                            SelectedItem="{Binding SortOrder}"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource SortOrderToText}, x:DataType=models:TodoSortOrder}"
                            WidthRequest="150" />
                    <Label Text="Category"
                           Style="{StaticResource Caption}"
                           Margin="12,0,0,0"
                           VerticalOptions="Center" />
                    <Picker ItemsSource="{Binding Filters}"
                            SelectedItem="{Binding SelectedFilter}"
                            ItemDisplayBinding="{Binding Name, x:DataType=models:Category}"
                            WidthRequest="170" />
                </HorizontalStackLayout>
                <Button Text="+ Add to-do"
                        Command="{Binding AddTodoCommand}" />
            </FlexLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="6"
                                 Padding="0,48"
                                 HorizontalOptions="Center">
                <Label Text="{Binding EmptyMessage}"
                       Style="{StaticResource SectionHeading}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding EmptyHint}"
                       Style="{StaticResource Caption}"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- To do -->
            <VerticalStackLayout IsVisible="{Binding HasOpenTodos}"
                                 Spacing="10">
                <Label Text="{Binding OpenTodos.Count, StringFormat='To do · {0}'}"
                       Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}"
                        Padding="0">
                    <VerticalStackLayout Style="{StaticResource ListRows}"
                                         BindableLayout.ItemsSource="{Binding OpenTodos}"
                                         BindableLayout.ItemTemplate="{StaticResource TodoRow}" />
                </Border>
            </VerticalStackLayout>

            <!-- Done -->
            <VerticalStackLayout IsVisible="{Binding HasDoneTodos}"
                                 Spacing="10">
                <Label Text="{Binding DoneTodos.Count, StringFormat='Done · {0}'}"
                       Style="{StaticResource SectionHeading}" />
                <Border Style="{StaticResource Card}"
                        Padding="0"
                        Opacity="0.7">
                    <VerticalStackLayout Style="{StaticResource ListRows}"
                                         BindableLayout.ItemsSource="{Binding DoneTodos}"
                                         BindableLayout.ItemTemplate="{StaticResource TodoRow}" />
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
