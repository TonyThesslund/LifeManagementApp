<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageColumn}">

            <!-- Weather location -->
            <Border Style="{StaticResource SectionCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Weather location"
                       Style="{StaticResource SectionHeading}" />
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Current: "
                                  TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Span Text="{Binding CurrentLocation.Name}"
                                  FontAttributes="Bold" />
                            <Span Text="{Binding CurrentLocation.Details, StringFormat=' ({0})', TargetNullValue=''}"
                                  TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Entry Text="{Binding SearchText}"
                           Placeholder="Search for a city"
                           ReturnCommand="{Binding SearchCommand}" />
                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchCommand}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsSearching}"
                                   IsVisible="{Binding IsSearching}"
                                   HorizontalOptions="Start" />

                <Label Text="{Binding SearchMessage}"
                       IsVisible="{Binding HasSearchMessage}"
                       Style="{StaticResource Caption}" />

                <!-- Search results: one row per place, tap to pick it -->
                <Border Style="{StaticResource Card}"
                        Padding="0"
                        IsVisible="{Binding HasSearchResults}">
                    <VerticalStackLayout Style="{StaticResource ListRows}"
                                         BindableLayout.ItemsSource="{Binding SearchResults}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:WeatherLocation">
                                <Grid Style="{StaticResource ListRow}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectLocationCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding Details}"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            </Border>

            <!-- Kitesurf wind limit -->
            <Border Style="{StaticResource SectionCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Kitesurf wind limit"
                       Style="{StaticResource SectionHeading}" />
                <Label Text="Home shows the kitesurf notice when the wind is above this."
                       Style="{StaticResource Caption}" />
                <HorizontalStackLayout Spacing="8">
                    <Entry Text="{Binding WindLimitText}"
                           Keyboard="Numeric"
                           WidthRequest="100" />
                    <Label Text="m/s"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding WindLimitError}"
                       IsVisible="{Binding HasWindLimitError}"
                       Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
            </Border>

            <!-- Categories -->
            <Border Style="{StaticResource SectionCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Categories"
                       Style="{StaticResource SectionHeading}" />
                <Label Text="Used to group to-dos and filter the to-do list."
                       Style="{StaticResource Caption}" />

                <!-- One row per category with a bin button, like the to-do list -->
                <Border Style="{StaticResource Card}"
                        Padding="0">
                    <VerticalStackLayout Style="{StaticResource ListRows}"
                                         BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.EmptyView>
                            <Label Text="No categories yet."
                                   Style="{StaticResource Caption}"
                                   Padding="16"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Grid ColumnDefinitions="*,Auto"
                                      Style="{StaticResource ListRow}"
                                      Padding="16,4,8,4">
                                    <Label Text="{Binding Name}"
                                           VerticalOptions="Center" />
                                    <ImageButton Grid.Column="1"
                                                 Source="{AppThemeBinding Light=bin_light.png, Dark=bin_dark.png}"
                                                 Style="{StaticResource IconButton}"
                                                 SemanticProperties.Description="Delete"
                                                 ToolTipProperties.Text="Delete"
                                                 Command="{Binding DeleteCategoryCommand, Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, x:DataType=vm:SettingsViewModel}"
                                                 CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <Entry Text="{Binding NewCategoryName}"
                           Placeholder="New category"
                           MaxLength="200"
                           ReturnCommand="{Binding AddCategoryCommand}" />
                    <Button Grid.Column="1"
                            Text="Add"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddCategoryCommand}" />
                </Grid>
                <Label Text="{Binding CategoryError}"
                       IsVisible="{Binding HasCategoryError}"
                       Style="{StaticResource ErrorText}" />
            </VerticalStackLayout>
            </Border>

            <!-- Theme -->
            <Border Style="{StaticResource SectionCard}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Theme"
                       Style="{StaticResource SectionHeading}" />
                <Label Text="System follows your computer's light or dark setting."
                       Style="{StaticResource Caption}" />
                <Picker ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding SelectedTheme}"
                        HorizontalOptions="Start"
                        WidthRequest="160" />
            </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
