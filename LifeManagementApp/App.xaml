<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LifeManagementApp"
             xmlns:converters="clr-namespace:LifeManagementApp.Converters"
             x:Class="LifeManagementApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:TodoSortOrderToTextConverter x:Key="SortOrderToText" />
            <converters:PriorityToColorConverter x:Key="PriorityToColor" />
            <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethrough" />
            <converters:BoolToTextConverter x:Key="BoolToText" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
